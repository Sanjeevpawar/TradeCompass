# ============================================================
# TradeCompass Environment Configuration
# ============================================================

# ============================================================
# Market data provider
# ============================================================
# mock or dhan
TRADECOMPASS_DATA_PROVIDER=mock

# ============================================================
# Dhan authentication
# ============================================================
# Dhan access tokens are generated automatically using TOTP
# and cached locally for reuse across TradeCompass restarts.
#
# Required only when TRADECOMPASS_DATA_PROVIDER=dhan
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# The access token is generated automatically and cached locally.
# TradeCompass generates and caches the 24-hour token automatically.

# ============================================================
# NIFTY underlying
# ============================================================
# NIFTY underlying security ID / segment.
# Verify against the current Dhan scrip master.
TRADECOMPASS_UNDERLYING_SECURITY_ID=13
TRADECOMPASS_UNDERLYING_SEGMENT=IDX_I

# ============================================================
# Risk configuration
# ============================================================
# Paper-trading capital used for position sizing.
# Default: ₹1,00,000
TRADECOMPASS_RISK_CAPITAL=100000

# Maximum planned risk per trade as a percentage of capital.
# 1.0 means 1% of configured capital.
TRADECOMPASS_RISK_PER_TRADE_PCT=1.0

# Maximum planned daily loss as a percentage of capital.
TRADECOMPASS_MAX_DAILY_LOSS_PCT=2.0

# Maximum number of trades allowed per day.
TRADECOMPASS_MAX_TRADES_PER_DAY=3

# Minimum required risk/reward ratio.
TRADECOMPASS_MIN_RR=1.5

# NIFTY option lot size.
# Verified against the current Dhan instrument master.
TRADECOMPASS_LOT_SIZE=65

# ============================================================
# Phase 7 contract-aware historical backtesting
# ============================================================
TRADECOMPASS_HISTORICAL_UNDERLYING_CSV=
TRADECOMPASS_HISTORICAL_OPTIONS_CSV=

# ============================================================
# Phase 11 live read-only engine
# ============================================================
TRADECOMPASS_LIVE_INTERVAL=5
TRADECOMPASS_LIVE_POLL_SECONDS=30
TRADECOMPASS_LIVE_DB=data/live/tradecompass_live.db